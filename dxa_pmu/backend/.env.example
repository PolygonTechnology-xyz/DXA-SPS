# PostgreSQL (the `db` service in ../docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dxa_pmu

# Claude. Create a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Encrypts saved Jira API tokens. Leave empty to auto-generate data/secret.key, or set your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Creates due scheduled reports inside the API process
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=60

# Re-imports every connected project's Jira tasks on a timer (read-only; nothing is written to Jira)
JIRA_SYNC_ENABLED=true
JIRA_SYNC_INTERVAL_MINUTES=30
